#!/usr/bin/env python3

import math
import time

import rclpy
from rclpy.node import Node

from std_msgs.msg import Bool
from std_msgs.msg import Float32
from std_msgs.msg import Int32
from std_msgs.msg import String


class GuidedTargetNode(Node):

    def __init__(self):
        super().__init__('guided_target_node')

        # Temporary avoidance geometry.
        self.declare_parameter('forward_offset_m', 3.0)
        self.declare_parameter('lateral_offset_m', 1.5)
        self.declare_parameter('slow_speed_scale', 0.5)
        self.declare_parameter('stale_timeout_s', 0.75)

        self.declare_parameter(
            'planner_timeout_s',
            0.75
        )

        self.forward_offset = float(
            self.get_parameter('forward_offset_m').value
        )

        self.lateral_offset = float(
            self.get_parameter('lateral_offset_m').value
        )

        self.slow_speed_scale = float(
            self.get_parameter('slow_speed_scale').value
        )

        self.stale_timeout = float(
            self.get_parameter('stale_timeout_s').value
        )

        self.planner_timeout = float(
            self.get_parameter(
                'planner_timeout_s'
            ).value
        )

        self.action = 'UNKNOWN'
        self.action_time = 0.0
        self.previous_action = None

        # One committed turn per avoidance episode.
        # Do not flip LEFT/RIGHT until the episode ends.
        self.avoidance_episode_active = False
        self.committed_side = 'NONE'

        # Increment only when a NEW Guided target is generated.
        self.request_seq = 0

        self.target_valid = False
        self.target_x = math.nan
        self.target_y = math.nan

        # Latest local-planner solution.
        self.planner_valid = False
        self.planner_x = math.nan
        self.planner_y = math.nan
        self.planner_angle = math.nan
        self.planner_clearance = math.nan
        self.planner_update_time = 0.0
        self.mode_request = 'HOLD'
        self.speed_scale = 0.0

        self.subscription = self.create_subscription(
            String,
            '/navigation/avoidance/action',
            self.action_callback,
            10
        )


        self.planner_valid_sub = self.create_subscription(
            Bool,
            '/navigation/local_planner/valid',
            self.planner_valid_callback,
            10
        )

        self.planner_x_sub = self.create_subscription(
            Float32,
            '/navigation/local_planner/x_forward_m',
            self.planner_x_callback,
            10
        )

        self.planner_y_sub = self.create_subscription(
            Float32,
            '/navigation/local_planner/y_right_m',
            self.planner_y_callback,
            10
        )

        self.planner_angle_sub = self.create_subscription(
            Float32,
            '/navigation/local_planner/angle_deg',
            self.planner_angle_callback,
            10
        )

        self.planner_clearance_sub = self.create_subscription(
            Float32,
            '/navigation/local_planner/clearance_m',
            self.planner_clearance_callback,
            10
        )

        self.active_pub = self.create_publisher(
            Bool,
            '/navigation/guided/active',
            10
        )

        self.target_valid_pub = self.create_publisher(
            Bool,
            '/navigation/guided/target_valid',
            10
        )

        self.x_pub = self.create_publisher(
            Float32,
            '/navigation/guided/x_forward_m',
            10
        )

        self.y_pub = self.create_publisher(
            Float32,
            '/navigation/guided/y_right_m',
            10
        )

        self.mode_pub = self.create_publisher(
            String,
            '/navigation/guided/mode_request',
            10
        )

        self.speed_pub = self.create_publisher(
            Float32,
            '/navigation/guided/speed_scale',
            10
        )

        self.seq_pub = self.create_publisher(
            Int32,
            '/navigation/guided/request_seq',
            10
        )

        self.timer = self.create_timer(
            0.20,
            self.evaluate
        )

        self.last_log = 0.0

        self.get_logger().info(
            'Guided target node started -- DRY RUN ONLY | '
            f'forward={self.forward_offset:.2f}m | '
            f'lateral={self.lateral_offset:.2f}m'
        )

    def action_callback(self, msg):
        self.action = msg.data
        self.action_time = time.monotonic()


    def planner_valid_callback(self, msg):
        self.planner_valid = bool(msg.data)
        self.planner_update_time = time.monotonic()

    def planner_x_callback(self, msg):
        self.planner_x = float(msg.data)
        self.planner_update_time = time.monotonic()

    def planner_y_callback(self, msg):
        self.planner_y = float(msg.data)
        self.planner_update_time = time.monotonic()

    def planner_angle_callback(self, msg):
        self.planner_angle = float(msg.data)
        self.planner_update_time = time.monotonic()

    def planner_clearance_callback(self, msg):
        self.planner_clearance = float(msg.data)
        self.planner_update_time = time.monotonic()

    def planner_solution_ready(self):

        fresh = (
            self.planner_update_time > 0.0
            and time.monotonic()
            - self.planner_update_time
            <= self.planner_timeout
        )

        return (
            fresh
            and self.planner_valid
            and math.isfinite(self.planner_x)
            and math.isfinite(self.planner_y)
        )

    def generate_new_target(self, side):

        if not self.planner_solution_ready():

            self.get_logger().warning(
                'LOCAL PLANNER HAS NO VALID PATH | '
                f'requested_side={side}'
            )

            self.mode_request = 'HOLD'
            self.target_valid = False
            self.target_x = math.nan
            self.target_y = math.nan
            self.speed_scale = 0.0

            return False

        # Check that planner target agrees with the
        # requested avoidance side.
        if (
            side == 'LEFT'
            and self.planner_y >= 0.0
        ):
            self.get_logger().warning(
                'Planner side mismatch: '
                'LEFT requested but target is not left'
            )
            return False

        if (
            side == 'RIGHT'
            and self.planner_y <= 0.0
        ):
            self.get_logger().warning(
                'Planner side mismatch: '
                'RIGHT requested but target is not right'
            )
            return False

        self.request_seq += 1

        self.mode_request = 'GUIDED'
        self.target_valid = True

        self.target_x = self.planner_x
        self.target_y = self.planner_y

        self.speed_scale = 1.0

        self.get_logger().info(
            'LOCAL PLAN ACCEPTED | '
            f'side={side} | '
            f'angle={self.planner_angle:+.0f}deg | '
            f'x={self.target_x:.2f}m | '
            f'y={self.target_y:.2f}m | '
            f'clearance={self.planner_clearance}'
        )

        return True

    def handle_action_change(self):

        if self.action in ('TURN_LEFT', 'TURN_RIGHT'):

            requested_side = (
                'LEFT'
                if self.action == 'TURN_LEFT'
                else 'RIGHT'
            )

            # Start a new avoidance episode.
            if not self.avoidance_episode_active:

                success = self.generate_new_target(
                    requested_side
                )

                if success:

                    self.avoidance_episode_active = True
                    self.committed_side = requested_side

                    self.get_logger().info(
                        f'AVOIDANCE EPISODE START | '
                        f'committed={self.committed_side}'
                    )

                else:

                    self.avoidance_episode_active = False
                    self.committed_side = 'NONE'

            # Perception changed its mind mid-turn.
            # Keep the existing Guided target rather than zig-zag.
            elif requested_side != self.committed_side:

                self.get_logger().warning(
                    f'IGNORING TURN FLIP | '
                    f'requested={requested_side} | '
                    f'committed={self.committed_side}'
                )

                self.mode_request = 'GUIDED'
                self.target_valid = True
                self.speed_scale = 1.0

            else:
                # Same turn direction: keep existing target.
                self.mode_request = 'GUIDED'
                self.target_valid = True
                self.speed_scale = 1.0

        elif self.action == 'SLOW':

            # Normally avoidance_decision_node keeps TURN_LEFT/RIGHT
            # while an avoidance episode is active.
            # If SLOW arrives anyway, preserve the committed target.
            if self.avoidance_episode_active:
                self.mode_request = 'GUIDED'
                self.target_valid = True
                self.speed_scale = 1.0
            else:
                self.mode_request = 'AUTO'
                self.target_valid = False
                self.target_x = math.nan
                self.target_y = math.nan
                self.speed_scale = self.slow_speed_scale

        elif self.action == 'KEEP_COURSE':

            if self.avoidance_episode_active:
                self.get_logger().info(
                    f'AVOIDANCE EPISODE COMPLETE | '
                    f'previous={self.committed_side}'
                )

            self.avoidance_episode_active = False
            self.committed_side = 'NONE'

            self.mode_request = 'AUTO'
            self.target_valid = False
            self.target_x = math.nan
            self.target_y = math.nan
            self.speed_scale = 1.0

        elif self.action in ('STOP', 'HOLD'):

            if self.avoidance_episode_active:
                self.get_logger().warning(
                    f'AVOIDANCE EPISODE ABORTED | '
                    f'previous={self.committed_side} | '
                    f'action={self.action}'
                )

            self.avoidance_episode_active = False
            self.committed_side = 'NONE'

            self.mode_request = 'HOLD'
            self.target_valid = False
            self.target_x = math.nan
            self.target_y = math.nan
            self.speed_scale = 0.0

        else:

            self.avoidance_episode_active = False
            self.committed_side = 'NONE'

            self.mode_request = 'HOLD'
            self.target_valid = False
            self.target_x = math.nan
            self.target_y = math.nan
            self.speed_scale = 0.0

    def publish_status(self):

        active = Bool()
        active.data = (
            self.mode_request == 'GUIDED'
            and self.target_valid
        )
        self.active_pub.publish(active)

        valid = Bool()
        valid.data = self.target_valid
        self.target_valid_pub.publish(valid)

        x = Float32()
        x.data = float(self.target_x)
        self.x_pub.publish(x)

        y = Float32()
        y.data = float(self.target_y)
        self.y_pub.publish(y)

        mode = String()
        mode.data = self.mode_request
        self.mode_pub.publish(mode)

        speed = Float32()
        speed.data = float(self.speed_scale)
        self.speed_pub.publish(speed)

        seq = Int32()
        seq.data = self.request_seq
        self.seq_pub.publish(seq)

    def evaluate(self):

        now = time.monotonic()

        # Missing navigation decision = fail safe.
        if (
            self.action_time == 0.0
            or now - self.action_time > self.stale_timeout
        ):
            self.action = 'HOLD'

        # Generate a NEW relative target only when action changes.
        if self.action != self.previous_action:
            self.handle_action_change()
            self.previous_action = self.action

            self.get_logger().info(
                'NEW REQUEST | '
                f'action={self.action} | '
                f'mode={self.mode_request} | '
                f'seq={self.request_seq} | '
                f'x_forward={self.target_x} | '
                f'y_right={self.target_y}'
            )

        self.publish_status()

        if now - self.last_log >= 1.0:
            self.last_log = now

            self.get_logger().info(
                'DRY RUN | '
                f'action={self.action:11s} | '
                f'mode={self.mode_request:6s} | '
                f'target_valid={self.target_valid} | '
                f'x={self.target_x} | '
                f'y={self.target_y} | '
                f'speed_scale={self.speed_scale:.2f} | '
                f'seq={self.request_seq} | '
                f'committed={self.committed_side}'
            )


def main(args=None):

    rclpy.init(args=args)

    node = GuidedTargetNode()

    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass

    node.destroy_node()
    rclpy.shutdown()


if __name__ == '__main__':
    main()
